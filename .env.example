# Local development only. Never commit a populated .env.
PORT=4173
SITE_ORIGIN=http://127.0.0.1:4173
BOOKING_DB=./data/bookings.sqlite
SMS_ENABLED=false
SMSAERO_EMAIL=
SMSAERO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=
METRIKA_COUNTER_ID=
# Print integration: secrets stay on the server and Raspberry Pi only.
PRINT_ENABLED=false
PRINT_AGENT_ID=station-printer-1
PRINT_AGENT_TOKEN=
# Persistent Pi SQLite database ID; do not automatically pair an empty replacement DB.
PRINT_AGENT_DATABASE_ID=

# Seconds per order part; clamped to 8–30 seconds.
CAFE_BOARD_PART_SECONDS=10

# Optional UX telemetry. Off unless explicitly set to 1.
UX_AUDIT_ENABLED=0
# When enabled, set to an absolute private directory outside dist.
UX_AUDIT_DIR=
