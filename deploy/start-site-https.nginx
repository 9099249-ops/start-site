limit_req_zone $binary_remote_addr zone=start_booking:10m rate=5r/m;
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name spotsup.ru www.spotsup.ru 5.129.250.42;
    return 301 https://spotsup.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name spotsup.ru www.spotsup.ru;
    ssl_certificate /etc/nginx/ssl/spotsup.ru/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/spotsup.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:START_TLS:10m;
    ssl_session_timeout 1d;
    client_max_body_size 4k;
    add_header X-Content-Type-Options nosniff always;

    if ($host = www.spotsup.ru) { return 301 https://spotsup.ru$request_uri; }
    location ^~ /api/print-agent/v1/ {
        client_max_body_size 256k;
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /api/admin/cafe/ {
        client_max_body_size 256k;
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /api/cafe/ {
        client_max_body_size 32k;
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /api/admin/content {
        client_max_body_size 8m;
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /api/bookings {
        limit_req zone=start_booking burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # START SUP browser game: independent static assets.
    location = /game { return 301 /game/; }
    location ^~ /game/ {
        add_header X-Robots-Tag "noindex, nofollow" always;
        root /opt/start-site/dist;
        index index.html;
        try_files $uri $uri/ =404;
    }
    # START performance assets
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    location ^~ /assets/ {
        root /opt/start-site/dist;
        try_files $uri =404;
        expires 1d;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ ^/[a-z0-9-]+\.(css|js)$ {
        root /opt/start-site/dist;
        try_files $uri =404;
        expires 5m;
        add_header X-Content-Type-Options nosniff always;
    }
    location / {
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

